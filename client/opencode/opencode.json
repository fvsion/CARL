{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "llamacpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (Mac host)",
      "options": {
        "baseURL": "http://__HOST__:__LLAMA_PORT__/v1",
        "apiKey": "{file:__HOME__/.config/carl/api-key}",
        "timeout": false,
        "chunkTimeout": 900000
      },
      "models": {}
    }
  }
}
