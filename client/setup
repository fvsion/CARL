#!/bin/sh
# CARL client setup: the one entry point on every computer (macOS and Linux, no sudo).
#   another computer:  unzip the client package (carl package on the server Mac), then ./setup
#   the server Mac:    carl install runs this file with the server on this Mac
# The setup is carl_setup.py next to this file (carl_client/app/setup.py; ./setup --help shows its options). This
# file only finds python3 and runs it. Windows: setup.cmd.
here=$(cd "$(dirname "$0")" && pwd) || exit 1
if ! command -v python3 >/dev/null 2>&1; then
  echo "error: the setup needs python3. On macOS, run xcode-select --install. On Linux, install the package python3." >&2
  exit 1
fi
exec python3 "$here/carl_setup.py" "$@"
