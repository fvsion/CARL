#!/usr/bin/env bash
# CARL client setup: the one entry point on every computer (macOS and Linux, no sudo).
#   another computer:  unzip the client package (./carl.sh package on the server Mac), then ./setup
#   the server Mac:    ./carl.sh install runs this file with the server on this Mac
# It asks one time which clients (OpenCode, Pi) and which options (the coder, the browser, web
# search, LSP), with the last install's choices as the defaults (~/.config/carl/client-install.env:
# the switches that the sync service applies again with each config from the dashboard); --yes
# takes the defaults. Then it installs or updates OpenCode and Pi when they are missing or older
# (install-clients.sh) and writes their configs (install.sh: backups first, your settings stay).
# Running it again is safe: an update is a new package unzipped over this folder, then ./setup.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LAST="$HOME/.config/carl/client-install.env"
NPM_PKG_OPENCODE="opencode-ai"
NPM_PKG_PI="@earendil-works/pi-coding-agent"

# The width of the help page and the messages: COLUMNS, else the terminal's, else 80.
out_width() {
  local w="${COLUMNS:-}"
  if ! [[ "$w" =~ ^[0-9]+$ ]]; then
    w=""
    [[ -t 1 ]] && w="$(tput cols 2>/dev/null || true)"
    [[ "$w" =~ ^[0-9]+$ ]] || w=80
  fi
  (( w >= 50 )) || w=50
  printf '%s' "$w"
}
W="$(out_width)"

# The help text from stdin, wrapped to the width. A line "TERM\tTEXT" (a backslash and a t) is a term
# with its text in a column; the other lines wrap with their own indent; an empty line stays.
wrap_help() {
  awk -v W="$W" -v C=24 '
    function emit(text, first, rest,    n, words, i, line, started) {
      n = split(text, words, / +/); line = first; started = 0
      for (i = 1; i <= n; i++) {
        if (words[i] == "") continue
        if (started && length(line) + 1 + length(words[i]) > W) { print line; line = rest words[i] }
        else if (started) line = line " " words[i]
        else { line = line words[i]; started = 1 }
      }
      print line
    }
    $0 == "" { print ""; next }
    (k = index($0, "\\t")) {
      t = substr($0, 1, k - 1); d = substr($0, k + 2); pad = sprintf("%" C "s", "")
      if (length(t) + 2 > C) { print t; emit(d, pad, pad) } else emit(d, sprintf("%-" C "s", t), pad)
      next
    }
    { match($0, /^ */); ind = substr($0, 1, RLENGTH); emit(substr($0, RLENGTH + 1), ind, ind) }'
}

# One message, wrapped to the width; its next lines are indented by 2.
say() { printf '%s\n' "$*" | fold -s -w "$(( W - 2 ))" | sed -e 's/ *$//' -e '2,$s/^/  /'; }

usage() {
  wrap_help <<'HELP'
CARL client setup: install OpenCode and Pi, and connect them to the CARL server.

Usage: ./setup [OPTION...]

On another computer, unzip the client package from the server Mac (./carl.sh package), then run ./setup in its folder. On a Mac, a double click on setup.command does the same. On the server Mac, ./carl.sh install runs this setup.

The setup asks one time which clients and which options you want. Press Enter to keep the value in brackets. Then it installs OpenCode and Pi when they are missing or older (into ~/.local, no sudo), and writes their configs. It keeps your own settings and makes a backup of each file before it changes it. At the end, it tells you what it did and if the server answers.

Options:
  -y, --yes\tTake the defaults. Ask no questions. Without a terminal, the setup does this too.
  --clients WHICH\tboth (the default), opencode or pi. "./setup pi" is the same as "--clients pi".
  --coder auto|on|off\tThe coder subagent: the main agent gives large tasks to it. auto (the default): on when the server runs 2 or more slots.
  --browser on|off\tThe browser tools: an agent opens and checks web pages. The default is on.
  --web-search WHICH\texa (the default), parallel or off. The search queries leave this computer: they go to Exa or Parallel.
  --lsp on|off\tLSP in OpenCode: OpenCode downloads and runs language servers for your code. The default is on.
  --no-install\tDo not install or update OpenCode and Pi. Write only the configs. --config-only does the same.
  --no-config\tInstall or update OpenCode and Pi. Do not write the configs. --clients-only does the same.
  -h, --help\tShow this help.

The defaults are the choices of your last setup on this computer (~/.config/carl/client-install.env). The sync service uses the same choices when it applies a new config from the dashboard. The environment variables of install.sh also work, for example WEB_SEARCH=off ./setup.

Where the server is (only when you need it):
  (no option)\tThe server in remote.json in this folder. The package has it, and the server writes it at each start.
  --local\tThe server runs on this computer.
  --vm [HOST]\tThe server runs on the host of this VM. The default HOST is 192.168.42.1.
  --host ADDRESS\tThe server is at ADDRESS.
  --port N\tThe port of the server. The default is 8080.
  --key-file FILE\tRead the API key from FILE. The package has the key in api-key.

To update: make a new package on the server Mac, unzip it over this folder (unzip -o), and run ./setup again. To turn a part off, run ./setup again and answer off. ./install.sh --help lists more switches.

Internals: setup runs install-clients.sh (OpenCode and Pi) and install.sh (the configs) in this folder. You do not need to run them yourself.
HELP
}

# ---- arguments -----------------------------------------------------------------------------------
YES=0; DO_INSTALL=1; DO_CONFIG=1; NET=()
o_clients=""; o_coder=""; o_browser=""; o_web=""; o_lsp=""
need() { [[ -n "${2:-}" ]] || { echo "error: $1 needs a value. Help: ./setup --help" >&2; exit 2; }; }
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help|help) usage; exit 0 ;;
    -y|--yes) YES=1 ;;
    both|opencode|pi) o_clients="$1" ;;
    --clients) need "$1" "${2:-}"; o_clients="$2"; shift ;;
    --coder) need "$1" "${2:-}"; o_coder="$2"; shift ;;
    --browser) need "$1" "${2:-}"; o_browser="$2"; shift ;;
    --web-search) need "$1" "${2:-}"; o_web="$2"; shift ;;
    --lsp) need "$1" "${2:-}"; o_lsp="$2"; shift ;;
    --no-install|--config-only) DO_INSTALL=0 ;;
    --no-config|--clients-only) DO_CONFIG=0 ;;
    --local) NET+=(--local) ;;
    --vm) NET+=(--vm); if [[ "${2:-}" =~ ^[0-9.]+$ ]]; then NET+=("$2"); shift; fi ;;
    --host|--port|--key-file|--key) need "$1" "${2:-}"; NET+=("$1" "$2"); shift ;;
    *) echo "error: setup does not know '$1'. Help: ./setup --help" >&2; exit 2 ;;
  esac
  shift
done
(( DO_INSTALL || DO_CONFIG )) || { echo "error: --no-install and --no-config together leave nothing to do." >&2; exit 2; }

# ---- the package's files: their modes first (a copy can lose them) --------------------------------
for f in api-key remote.json; do [[ -f "$HERE/$f" ]] && chmod 600 "$HERE/$f"; done
for f in setup setup.command install.sh install-clients.sh configure.py carl-sync.py; do
  [[ -f "$HERE/$f" ]] && chmod u+x "$HERE/$f"
done

json_field() {  # FILE KEY: a string or number field of a JSON object ("" when none)
  python3 -c 'import json,sys
try:
    v = json.load(open(sys.argv[1])).get(sys.argv[2], "")
except Exception:
    v = ""
print(v if isinstance(v, (str, int)) and not isinstance(v, bool) else "")' "$1" "$2" 2>/dev/null || true
}
command -v python3 >/dev/null 2>&1 || {
  say "error: the setup needs python3. On macOS, run xcode-select --install. On Linux, install the package python3." >&2
  exit 1; }
version=""; [[ -f "$HERE/VERSION" ]] && version="$(tr -d '[:space:]' < "$HERE/VERSION")"
server=""; server_version=""
if [[ -s "$HERE/remote.json" ]]; then
  server="$(json_field "$HERE/remote.json" host):$(json_field "$HERE/remote.json" port)"
  server_version="$(json_field "$HERE/remote.json" version)"
fi
say "CARL client setup${version:+ (client package $version)}${server:+. The server: $server}."
if [[ -n "$version" && -n "$server_version" && "$version" != "$server_version" ]]; then
  say "Note: this package is version $version, but the server ran CARL $server_version when it wrote remote.json."
fi

# ---- the choices: options > environment > the last setup > CARL's defaults ------------------------
last() {  # KEY: its value in the last setup's switches ("" when none); the file is read, never run
  [[ -f "$LAST" ]] || return 0
  sed -n "s/^$1=//p" "$LAST" | tail -n1
}
envset() { local n; for n in "$@"; do [[ -n "${!n:-}" ]] && return 0; done; return 1; }
from() {  # KEY...: "env" when the environment sets one of them, else "last"
  if envset "$@"; then echo env; else echo last; fi
}
get() {  # SOURCE KEY
  if [[ "$1" == env ]]; then printf '%s' "${!2:-}"; else last "$2"; fi
}

src="$(from CLIENTS)"; d_clients="$(get "$src" CLIENTS)"; d_clients="${d_clients:-both}"
src="$(from CODER NO_CODER)"
if [[ "$(get "$src" NO_CODER)" == 1 || "$(get "$src" CODER)" == 0 ]]; then d_coder=off
elif [[ "$(get "$src" CODER)" == 1 ]]; then d_coder=on; else d_coder=auto; fi
src="$(from NO_BROWSER)"; d_browser=on; [[ "$(get "$src" NO_BROWSER)" == 1 ]] && d_browser=off
src="$(from WEB_SEARCH)"; d_web="$(get "$src" WEB_SEARCH)"; d_web="${d_web:-exa}"
src="$(from NO_LSP LSP)"; d_lsp=on
[[ "$(get "$src" NO_LSP)" == 1 || "$(get "$src" LSP)" == 0 ]] && d_lsp=off

# normalize WORD KIND: the answer as one of the values of KIND, or "" when it is not one
normalize() {
  local a; a="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')"
  case "$2" in
    clients) case "$a" in both|b|all) echo both ;; opencode|o|oc) echo opencode ;; pi|p) echo pi ;; esac ;;
    coder) case "$a" in auto|a) echo auto ;; on|y|yes|1) echo on ;; off|n|no|0) echo off ;; esac ;;
    onoff) case "$a" in on|y|yes|1) echo on ;; off|n|no|0) echo off ;; esac ;;
    web) case "$a" in exa|e) echo exa ;; parallel|p) echo parallel ;; off|n|no|0) echo off ;; esac ;;
  esac
}
check() {  # VALUE KIND OPTION: the value, or an error for a bad option value
  local v; v="$(normalize "$1" "$2")"
  [[ -n "$v" ]] || { echo "error: $3 does not take '$1'. Help: ./setup --help" >&2; exit 2; }
  printf '%s' "$v"
}
for pair in "d_clients:clients:CLIENTS" "d_web:web:WEB_SEARCH"; do       # a bad value from the environment
  IFS=: read -r var kind name <<< "$pair"
  [[ -n "$(normalize "${!var}" "$kind")" ]] || { echo "error: $name does not take '${!var}'." >&2; exit 2; }
done
d_clients="$(normalize "$d_clients" clients)"; d_web="$(normalize "$d_web" web)"
[[ -z "$o_clients" ]] || d_clients="$(check "$o_clients" clients --clients)"
[[ -z "$o_coder" ]] || d_coder="$(check "$o_coder" coder --coder)"
[[ -z "$o_browser" ]] || d_browser="$(check "$o_browser" onoff --browser)"
[[ -z "$o_web" ]] || d_web="$(check "$o_web" web --web-search)"
[[ -z "$o_lsp" ]] || d_lsp="$(check "$o_lsp" onoff --lsp)"

# ask TEXT DEFAULT KIND VAR: one question; Enter keeps the default; a bad answer asks again
ask() {
  local a v
  while :; do
    say "$1"
    read -r -p "  [$2] " a || a=""
    [[ -n "$a" ]] || { printf -v "$4" '%s' "$2"; return 0; }
    v="$(normalize "$a" "$3")"
    if [[ -n "$v" ]]; then printf -v "$4" '%s' "$v"; return 0; fi
    say "Type one of the words in the question, or press Enter."
  done
}
if (( YES == 0 )) && [[ -t 0 ]] && { (( DO_CONFIG )) || [[ -z "$o_clients" ]]; }; then
  echo
  say "CARL asks some questions one time. Press Enter to keep the value in brackets."
  [[ -n "$o_clients" ]] || ask "1. Which clients: both, opencode or pi?" "$d_clients" clients d_clients
  if (( DO_CONFIG )); then
    [[ -n "$o_coder" ]] || ask "2. The coder subagent: the main agent gives large tasks to it. auto (on when the server runs 2 or more slots), on or off?" "$d_coder" coder d_coder
    [[ -n "$o_browser" ]] || ask "3. The browser tools: an agent opens and checks web pages. on or off?" "$d_browser" onoff d_browser
    [[ -n "$o_web" ]] || ask "4. Web search: the search queries leave this computer (they go to Exa or Parallel). exa, parallel or off?" "$d_web" web d_web
    if [[ "$d_clients" != pi && -z "$o_lsp" ]]; then
      ask "5. LSP in OpenCode: OpenCode downloads and runs language servers for your code. on or off?" "$d_lsp" onoff d_lsp
    fi
  fi
fi
echo
say "Clients: $d_clients. Options: coder $d_coder, browser $d_browser, web search $d_web$([[ "$d_clients" != pi ]] && echo ", LSP $d_lsp")."
[[ "$d_web" == off ]] || say "Web search sends the search queries to $d_web, outside this computer. Everything else stays between this computer and the server."

# ---- OpenCode and Pi: install or update when they are missing or older ---------------------------
export PATH="$HOME/.local/bin:$PATH"
version_of() { "$1" --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -n1 || true; }
newest() {  # NPM-PACKAGE: the newest version on npm ("" when npm does not answer in 20 s)
  command -v npm >/dev/null 2>&1 || return 0
  npm view "$1" version --fetch-timeout=20000 --fetch-retries=0 2>/dev/null | tail -n1 | tr -d '[:space:]' || true
}
older() { [[ "$1" != "$2" && "$(printf '%s\n%s\n' "$1" "$2" | sort -V | head -n1)" == "$1" ]]; }
label() { if [[ "$1" == pi ]]; then echo Pi; elif [[ "$1" == opencode ]]; then echo OpenCode; else echo "OpenCode and Pi"; fi; }
chosen=(); [[ "$d_clients" != pi ]] && chosen+=(opencode); [[ "$d_clients" != opencode ]] && chosen+=(pi)
todo=(); act=(); was=(); latest=()
for c in "${chosen[@]}"; do
  pkg="$NPM_PKG_OPENCODE"; [[ "$c" == pi ]] && pkg="$NPM_PKG_PI"
  have=""; new=""; a=keep
  if command -v "$c" >/dev/null 2>&1; then have="$(version_of "$c")"; fi
  if (( DO_INSTALL == 0 )); then a=skip
  elif ! command -v "$c" >/dev/null 2>&1; then a=install
  else
    new="$(newest "$pkg")"
    if [[ -z "$new" ]]; then a=unknown
    elif [[ -n "$have" ]] && older "$have" "$new"; then a=update; fi
  fi
  [[ "$a" == install || "$a" == update ]] && todo+=("$c")
  act+=("$a"); was+=("${have:-unknown}"); latest+=("$new")
done
if (( ${#todo[@]} )); then
  which=both; (( ${#todo[@]} == 1 )) && which="${todo[0]}"
  echo
  say "CARL installs $(label "$which") (install-clients.sh, from npm, into ~/.local)."
  COLUMNS="$W" "$HERE/install-clients.sh" "$which" || {
    rc=$?; say "error: the install of $(label "$which") stopped (exit code $rc). Its output is above. Correct the cause, then run ./setup again." >&2
    exit "$rc"; }
  hash -r
fi
report=()
i=0
for c in "${chosen[@]}"; do
  now=""; command -v "$c" >/dev/null 2>&1 && now="$(version_of "$c")"
  case "${act[$i]}" in
    install) report+=("$(label "$c"): installed (version ${now:-unknown}).") ;;
    update) report+=("$(label "$c"): updated from version ${was[$i]} to ${now:-unknown}.") ;;
    keep) report+=("$(label "$c"): version ${was[$i]}, up to date.") ;;
    unknown) report+=("$(label "$c"): version ${was[$i]}. CARL cannot check for a newer version (npm does not answer).") ;;
    skip) report+=("$(label "$c"): not changed (--no-install).") ;;
  esac
  i=$(( i + 1 ))
done

# ---- the configs (install.sh) ---------------------------------------------------------------------
smoke=""
if (( DO_CONFIG )); then
  echo
  say "CARL writes the configs (install.sh)."
  export CLIENTS="$d_clients" WEB_SEARCH="$d_web"
  unset CODER NO_CODER LSP
  case "$d_coder" in on) export CODER=1 ;; off) export NO_CODER=1 ;; esac
  NO_BROWSER=0; [[ "$d_browser" == off ]] && NO_BROWSER=1
  NO_LSP=0; [[ "$d_lsp" == off ]] && NO_LSP=1
  export NO_BROWSER NO_LSP
  # the switches that setup does not ask for: from the environment, else as in the last setup
  for k in BROWSER_HEADED NO_SIDEBAR NO_SWITCHER NO_MODEL_CHECK NO_BACKGROUND_SUBAGENTS NO_CACHE LLAMA_CTX \
           NO_REMINDER; do
    if [[ -z "${!k:-}" ]]; then v="$(last "$k")"; [[ -z "$v" ]] || export "$k=$v"; fi
  done
  out="$(mktemp)"; trap 'rm -f "$out"' EXIT
  set +e
  COLUMNS="$W" "$HERE/install.sh" ${NET[@]+"${NET[@]}"} 2>&1 | tee "$out"
  rc="${PIPESTATUS[0]}"
  set -e
  if (( rc != 0 )); then
    say "error: the config step stopped (exit code $rc). Its output is above. Your files have backups (FILE.bak). Correct the cause, then run ./setup again." >&2
    exit "$rc"
  fi
  smoke="$(awk '/^(OK: the server answers|Note: no server runs at)/ { f = 1 } f' "$out" | tr -s ' \n' '  ' | sed 's/ *$//')"
  backups="$(grep -cE '^  backed up ' "$out" || true)"
fi

# ---- what the setup did ---------------------------------------------------------------------------
echo
say "CARL setup is done."
for r in ${report[@]+"${report[@]}"}; do say "  $r"; done
if (( DO_CONFIG )); then
  say "  Configs: written$([[ "${backups:-0}" != 0 ]] && echo ". Backups of the changed files: FILE.bak next to each file (the original: FILE.before-carl)")."
  say "  Smoke test: ${smoke:-no result (see the output above)}"
else
  say "  Configs: not changed (--no-config)."
fi
if (( DO_CONFIG )) && [[ "$smoke" != OK:* ]]; then
  say "Start the server on the server Mac (./carl.sh), then try again: the clients work when the server runs."
fi
next="opencode"; [[ "$d_clients" == pi ]] && next="pi"; [[ "$d_clients" == both ]] && next="opencode (or: pi)"
say "Next: open a new terminal. Go to your project folder and run: $next"
