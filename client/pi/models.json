{
  "providers": {
    "llamacpp": {
      "baseUrl": "http://__HOST__:__LLAMA_PORT__/v1",
      "api": "openai-completions",
      "apiKey": "!cat ~/.config/carl/api-key",
      "authHeader": true,
      "compat": {
        "supportsDeveloperRole": false,
        "supportsReasoningEffort": false,
        "thinkingFormat": "chat-template",
        "chatTemplateKwargs": {
          "enable_thinking": {
            "$var": "thinking.enabled"
          },
          "preserve_thinking": true,
          "reasoning_effort": {
            "$var": "thinking.effort",
            "omitWhenOff": true
          }
        },
        "maxTokensField": "max_tokens"
      },
      "models": []
    }
  }
}
